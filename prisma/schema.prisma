// Portfolio monolith — relational schema.
// One Next.js app owns both the public site and the admin CMS; this is its store.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth -------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// --- Projects ---------------------------------------------------------------

model Project {
  id String @id @default(cuid())

  // Basic
  title            String
  slug             String  @unique
  shortDescription String
  fullDescription  String  @db.Text
  category         String // e.g. "Business Application", "Web Platform", "Integration"
  projectType      String // e.g. "POS System", "Company Website"
  year             Int
  clientType       String // "Confidential", "Enterprise F&B", "Startup", ...
  role             String  @default("Full-Stack Engineer")

  // Case study narrative
  businessProblem    String @default("") @db.Text
  solution           String @default("") @db.Text
  technicalChallenges String @default("") @db.Text
  technicalDecisions String @default("") @db.Text
  outcome            String @default("") @db.Text
  caseStudyContent   String @default("") @db.Text
  architectureText   String @default("") @db.Text // optional ascii/tree diagram

  // Media
  featuredImage    String? // storage key/url
  architectureImage String?

  // Links
  demoUrl   String?
  githubUrl String?

  // SEO
  seoTitle       String?
  seoDescription String?
  ogImage        String?

  // Publishing
  layout    String  @default("standard") // standard | flagship | split | horizontal | compact
  accent    String  @default("signal")
  published Boolean @default(false)
  featured  Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images       ProjectImage[]
  capabilities ProjectCapability[]
  technologies ProjectTechnology[]

  @@index([published, featured])
  @@index([sortOrder])
  @@map("projects")
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  url       String
  alt       String  @default("")
  kind      String  @default("gallery") // gallery | featured | architecture
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_images")
}

// Business capabilities, told as outcomes (not a raw feature list).
model ProjectCapability {
  id        String  @id @default(cuid())
  projectId String
  title     String
  detail    String  @default("") @db.Text
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_capabilities")
}

model Technology {
  id        String  @id @default(cuid())
  name      String  @unique
  category  String  @default("Application") // Application | Data | Integration | Infrastructure
  sortOrder Int     @default(0)

  projects ProjectTechnology[]

  @@map("technologies")
}

model ProjectTechnology {
  projectId    String
  technologyId String
  sortOrder    Int    @default(0)

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@map("project_technologies")
}

// --- Site content -----------------------------------------------------------

model Service {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  summary     String  @db.Text
  detail      String  @default("") @db.Text
  deliverables String @default("") @db.Text // newline separated
  sortOrder   Int     @default(0)
  published   Boolean @default(true)

  @@map("services")
}

// Flexible key/value store for editorial copy (hero, about, contact intro...).
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model SocialLink {
  id        String  @id @default(cuid())
  label     String
  url       String
  handle    String  @default("")
  sortOrder Int     @default(0)

  @@map("social_links")
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  company     String   @default("")
  email       String
  projectType String   @default("")
  budgetRange String   @default("")
  message     String   @db.Text
  status      String   @default("unread") // unread | read | archived
  createdAt   DateTime @default(now())

  @@index([status])
  @@map("contact_messages")
}
