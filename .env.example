# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# The bundled docker-compose service exposes Postgres on host port 5433.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://portfolio:portfolio_dev_pw@localhost:5433/portfolio?schema=public"
# Direct (non-pooled) connection used by `prisma migrate`. On Vercel + Neon this
# is filled in automatically; locally it can reuse DATABASE_URL.
DATABASE_URL_UNPOOLED="${DATABASE_URL}"

# ---------------------------------------------------------------------------
# Authentication
# AUTH_SECRET signs the admin session cookie. Generate a strong value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Seed admin account (used only by `npm run db:seed`). Change before deploying.
ADMIN_EMAIL="admin@studio.dev"
ADMIN_PASSWORD="change-me-in-production"
ADMIN_NAME="Studio Admin"

# ---------------------------------------------------------------------------
# Storage
# "local" stores uploads in /public/uploads (development only).
# "blob" stores them in Vercel Blob — required on Vercel, whose filesystem is
# read-only. Connecting a Blob st ore to the Vercel project sets the token.
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
# BLOB_READ_WRITE_TOKEN=""

# Public base URL, used for absolute canonical/OG/sitemap links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
